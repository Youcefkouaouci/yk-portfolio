---
import '../styles/global.css';
import Header from '../components/shell/Header.astro';
import Footer from '../components/shell/Footer.astro';
import EdgeTabs from '../components/shell/EdgeTabs.astro';
import Taskbar from '../components/shell/Taskbar.vue';
import { profile } from '../data/profile';
import { windows } from '../data/windows';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — développeur full stack, ingénieur en architecture de formation`,
  description = `Portfolio de ${profile.name} : développement full stack (PHP, Laravel, Symfony, Vue, Angular) et projets d'architecture.`,
} = Astro.props;
---

<!doctype html>
<html lang="fr" data-theme="calque">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E4ECE9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Applique le rendu mémorisé avant le premier affichage (évite le flash de thème).
      (function () {
        try {
          var t = localStorage.getItem('yk-theme');
          if (t === 'blueprint' || t === 'calque') {
            document.documentElement.dataset.theme = t;
            document.querySelector('meta[name="theme-color"]').setAttribute('content', t === 'blueprint' ? '#0D1013' : '#E4ECE9');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body id="top">
    <a href="#main" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="main" class="desktop">
      <slot />
    </main>
    <Footer />
    <EdgeTabs />
    <Taskbar
      client:load
      windows={windows}
      studio={profile.studio}
      name={profile.name}
      email={profile.email}
      github={profile.github}
      linkedin={profile.linkedin}
    />
  </body>
</html>
